{
  "name": "devorecruiter-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "lint": "ng lint",
    "lint:ci": "eslint . --ext .ts,.html --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ci": "npx vitest run",
    "verify": "npm run lint:ci && npm run typecheck && npm run format:check && npm run test:ci",
    "ci": "npm run verify",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@fontsource-variable/outfit": "5.2.8",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/d3": "^7.4.3",
    "apexcharts": "^5.10.6",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "ng-apexcharts": "^2.4.0",
    "ng2-charts": "^10.0.0",
    "ngx-echarts": "^21.0.0",
    "ngx-markdown": "^21.2.0",
    "ngx-quill": "^30.0.1",
    "quill": "2.0.2",
    "rxjs": "~7.8.0",
    "swiper": "^12.1.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/highlight.js": "^9.12.4",
    "@types/quill": "^2.0.14",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "angular-eslint": "^21.3.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.1",
    "undici": "^8.10.0"
  }
